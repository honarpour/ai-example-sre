        "required": [
          "id",
          "alert",
          "status",
          "tldr",
          "steps",
          "evidence",
          "hypotheses",
          "feedback",
          "warnings",
          "created_at",
          "completed_at",
          "total_tool_calls",
          "total_cost_usd",
          "wall_time_ms",
          "error"
        ],
        "title": "Investigation"
      },
