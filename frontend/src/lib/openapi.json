          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActionKind": {
        "type": "string",
        "enum": [
          "immediate_mitigation",
          "verification",
          "durable_fix"
        ],
        "title": "ActionKind"
      },
      "AgentStep": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "tool_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Name"
          },
          "tool_input": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Input"
          },
          "tool_output_summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Output Summary"
          },
          "status": {
            "$ref": "#/components/schemas/AgentStepStatus"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidence Ids"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "id",
          "label",
          "tool_name",
          "tool_input",
          "tool_output_summary",
          "status",
          "started_at",
          "finished_at",
          "evidence_ids",
          "error"
        ],
        "title": "AgentStep"
      },
      "AgentStepStatus": {
        "type": "string",
        "enum": [
          "running",
          "complete",
          "error"
        ],
        "title": "AgentStepStatus"
      },
      "Alert": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "stack_trace": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stack Trace"
          },
          "fired_at": {
            "type": "string",
            "format": "date-time",
            "title": "Fired At"
          },
          "source": {
            "$ref": "#/components/schemas/AlertSource",
            "default": "manual"
          },
          "scenario": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scenario"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "service",
          "severity",
          "message",
          "stack_trace",
          "fired_at",
          "source",
          "scenario"
        ],
        "title": "Alert"
      },
      "AlertSource": {
        "type": "string",
        "enum": [
          "webhook",
          "manual"
        ],
        "title": "AlertSource"
      },
      "AskFollowUpRequest": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AskFollowUpRequest"
      },
      "AskFollowUpResponse": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "cited_evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Cited Evidence Ids"
          }
        },
        "type": "object",
        "required": [
          "answer",
          "cited_evidence_ids"
        ],
        "title": "AskFollowUpResponse"
      },
      "Confidence": {
        "type": "string",
        "enum": [
          "high",
          "medium",
          "low"
        ],
        "title": "Confidence"
      },
      "CreateAlertRequest": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "service": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Service"
          },
          "severity": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Severity"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "stack_trace": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stack Trace"
          },
          "fired_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fired At"
          },
          "source": {
            "$ref": "#/components/schemas/AlertSource",
            "default": "manual"
          },
          "scenario": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scenario"
          }
        },
        "type": "object",
        "title": "CreateAlertRequest",
        "description": "Body for POST /api/alerts. A raw-JSON alert (from a real webhook) supplies title/\nservice/severity/message directly. A scenario-preset alert (from the 'Create Alert'\nUI) may supply only `scenario` \u2014 the server fills the rest in from the fixture's\nAlertTemplate, so the frontend never duplicates alert content that already lives in\nthe fixtures. Any field given explicitly overrides the scenario's default."
      },
      "Evidence": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "$ref": "#/components/schemas/EvidenceKind"
          },
