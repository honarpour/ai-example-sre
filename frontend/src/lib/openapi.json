        "operationId": "ask_follow_up_route_api_investigations__investigation_id__ask_post",
        "parameters": [
          {
            "name": "investigation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Investigation Id"
            }
