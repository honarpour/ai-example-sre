            "type": "string",
            "title": "Hypothesis Id"
          },
          "helpful": {
            "type": "boolean",
            "title": "Helpful"
          },
          "actual_root_cause": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
