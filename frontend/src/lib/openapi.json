              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/investigations/{investigation_id}/stream": {
      "get": {
        "summary": "Stream Investigation",
        "operationId": "stream_investigation_api_investigations__investigation_id__stream_get",
