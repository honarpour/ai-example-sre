            },
            "type": "array",
            "title": "Evidence Ids"
          },
          "suggested_actions": {
            "items": {
              "$ref": "#/components/schemas/SuggestedAction"
            },
            "type": "array",
            "title": "Suggested Actions"
          }
        },
        "type": "object",
        "required": [
          "id",
          "rank",
          "summary",
          "reasoning",
          "confidence",
          "evidence_ids",
          "suggested_actions"
        ],
        "title": "Hypothesis"
      },
      "Investigation": {
