# Copy to .env if you want to override defaults. None of this is required to
# run the mock-data demo — see decision #3 in PLAN.md.

# GitHub source: 'mock' (default) or 'live' (Phase 7a, deferred — not yet implemented).
DATA_SOURCE=mock

# The `claude` CLI must be installed on PATH either way.
CLAUDE_BINARY=claude
# Used for phase B (synthesis) and the eval judge - the reasoning step actually being graded.
CLAUDE_MODEL=
# Optional override for phase A (evidence gathering) specifically. Falls back to CLAUDE_MODEL
# when unset. Phase A is mechanical tool orchestration, not the reasoning step being graded, so
# a cheaper/faster model here is close to free cost savings - e.g. claude-haiku-4-5-20251001.
CLAUDE_MODEL_PHASE_A=

# Optional (Phase 7d). Unset: the CLI uses its interactive OAuth login (`claude /login` once) -
# the original decision #4 default, no key management in the app. Set: the CLI runs in --bare
# mode instead - no dependency on staying logged into an interactive session, and cheaper per
# investigation (skips the full Claude Code system prompt/hooks/plugins). Get a key at
# https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=

MAX_CONCURRENT_INVESTIGATIONS=2
INVESTIGATION_TIMEOUT_S=120
# Soft-then-hard budget on phase A tool calls: stated as guidance in the prompt, enforced as a
# hard ceiling that cuts the stream short and synthesizes on evidence gathered so far (with a
# UI warning) rather than letting a looping agent run to the timeout above. 50, not a smaller
# guess: this project's own recorded runs used 22-32 real tool calls for correct investigations
# (see PLAN.md) - set with headroom above that, not below it.
MAX_TOOL_CALLS=50

CORS_ORIGINS=http://localhost:5173

# Observability source: 'mock' (default) or 'live' (Phase 7b — a self-hosted
# Prometheus/Loki/GlitchTip stack; see observability-stack/README.md to stand it up).
# Independent of DATA_SOURCE above on purpose: this project's GitHub and observability
# live-cutovers are on different timelines, so one flag couldn't express "observability is
# live, GitHub still isn't" — which is genuinely where this project is right now.
OBSERVABILITY_DATA_SOURCE=mock
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
GLITCHTIP_URL=http://localhost:8001
GLITCHTIP_API_TOKEN=
GLITCHTIP_ORG_SLUG=sre-demo
GLITCHTIP_PROJECT_SLUG=payments-api
